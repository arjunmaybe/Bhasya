# Copy to .env for local development. Production uses hosted secrets.
#
# Locked topology (ARCHITECTURE.md, frozen):
#   Cloudflare → Cloudflare Worker (apps/api/src/worker.ts, same Hono router)
#   → PostgreSQL/pgvector. Auth: Better Auth sessions (production) / single
#   seeded dev user (validation build). Node/PGlite/filesystem adapters below
#   are LOCAL DEVELOPMENT ONLY and never replace the production architecture.
#
# Local validation loop (single seeded dev user, same contracts):
#   DATABASE_URL= (empty => PGlite, same Postgres dialect) or
#   DATABASE_URL=postgres://bhasya:bhasya@localhost:5432/bhasya (real PG via
#     `docker compose up -d postgres`, then `npm run db:migrate`)
#   npm run dev:api   # migrate + seed, serves the Hono app locally
#   npm run dev:web   # Next.js reader (local dev)
#
# Worker deployment bindings (wrangler secrets/vars, set in Cloudflare):
#   DATABASE_URL (Supabase PostgreSQL/pgvector; Hyperdrive optional, production only)
#   BHASYA_MODEL_API_KEY / BHASYA_MODEL_ID / BHASYA_MODEL_ENDPOINT (real AI)
#   BHASYA_USE_AUTH=1 + BETTER_AUTH_SECRET + BETTER_AUTH_URL (Better Auth)
#   $0 staging storage: SUPABASE_URL + SUPABASE_SERVICE_KEY (private bucket
#     bhasya-artifacts); optional future R2 bucket binding (production profile only)
# $0 staging (no R2 billing): Supabase Storage behind the same StoragePort.
#   Set SUPABASE_URL + SUPABASE_SERVICE_KEY (wrangler secret, private bucket);
#   SUPABASE_STORAGE_BUCKET defaults to `bhasya-artifacts` (keep private).
#   Selection: R2 binding wins when present → else Supabase env → else local
#   filesystem (dev) / fail-closed (prod). App sees only StoragePort put/get.
DATABASE_URL=
API_PORT=8787
BHASYA_API_URL=http://localhost:8787
NEXT_PUBLIC_BHASYA_API_URL=http://localhost:8787
# $0 staging storage (Supabase Storage, private bucket bhasya-artifacts):
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key: server-side only, never commit>
# SUPABASE_STORAGE_BUCKET=bhasya-artifacts
# Optional real provider (default is the grounded dev adapter):
# BHASYA_MODEL_API_KEY=
# BHASYA_MODEL_ID=
# BHASYA_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
